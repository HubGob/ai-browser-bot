# ai-browser-bot configuration
# Copy this file to `.env` and fill in your values.
# Loaded automatically by the CLI on startup (python-dotenv).

# --- Provider authentication ---
# Primary key for OpenAI. The CLI checks OPENAI_API_KEY first, then
# LLM_API_KEY, so you can use whichever is most convenient.
# Local servers (Ollama, LM Studio, etc.) typically ignore the key.
OPENAI_API_KEY=sk-your-key-here

# Alias accepted as a fallback for the API key:
# LLM_API_KEY=sk-your-key-here

# --- Provider endpoint & model ---
# OpenAI default (requires a valid key):
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Local model example (Ollama / LM Studio) ---
# Uncomment and adjust to use a locally-running OpenAI-compatible server.
# These do NOT require a real API key.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3
# OPENAI_API_KEY=ollama  # a dummy value; required only by some servers
